# Copy to .env.local for development. On Vercel, add these under Project → Settings → Environment Variables.

# true = run on sample data in the browser (no backend needed). Set to false once the API is live.
VITE_USE_MOCK=true

# FastAPI base URL on Render, including the version prefix.
VITE_API_URL=https://cadence-api.onrender.com/api/v1


# history (default, needs the vercel.json rewrite) or hash (for static hosts without rewrites)
VITE_ROUTER=history
