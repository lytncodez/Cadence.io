# Neon: copy the connection string from the Neon dashboard (Connection Details → "Pooled connection").
# Either form works; the app converts it for asyncpg and enables SSL.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cadence?sslmode=require

# Long random string. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://cadence-web.vercel.app

# Password given to the seeded demo accounts (Abena, Kojo, Efua, Yaw). Change it before real use.
SEED_PASSWORD=cadence2026

# ---- SMS (mock = log only, nothing sent) ----
SMS_PROVIDER=mock            # mock | arkesel | hubtel
SMS_SENDER_ID=Cadence        # max 11 characters; must be approved by your provider
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# ---- Email (mock = log only) ----
EMAIL_PROVIDER=mock          # mock | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=               # Gmail: an App Password, not your normal password
SMTP_FROM=

# ---- AI wording (numbers always come from Cadence's own analytics) ----
AI_PROVIDER=mock             # mock | anthropic | openai
AI_MODEL=                    # the provider's model id, e.g. from docs.claude.com or platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Daily digest trigger (cron-job.org calls POST /api/v1/alerts/cron with header X-Cron-Secret) ----
CRON_SECRET=

# ---- Password reset links and website demo requests ----
APP_URL=http://localhost:5173  # your Vercel address in production, no trailing slash
RESET_LINK_MINUTES=60
DEMO_NOTIFY_EMAIL=             # where "Book a demo" requests are emailed (needs EMAIL_PROVIDER=smtp)
DEMO_NOTIFY_SMS=               # optional: also text this number, e.g. +233 24 000 0000
