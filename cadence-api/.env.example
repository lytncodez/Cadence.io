# Neon: copy the connection string from the Neon dashboard (Connection Details → "Pooled connection").
# Either form works; the app converts it for asyncpg and enables SSL.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/cadence?sslmode=require

# Long random string (at least 32 characters; the API refuses to start on Neon without one). Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,https://cadence-web.vercel.app

# Password given to the seeded demo accounts (Abena, Kojo, Efua, Yaw). Change it before real use.
SEED_PASSWORD=cadence2026

# ---- SMS (mock = log only, nothing sent) ----
SMS_PROVIDER=mock            # mock | africastalking | arkesel | hubtel
SMS_SENDER_ID=               # max 11 characters, approved by your provider. Africa's Talking: blank = their default sender
AFRICASTALKING_USERNAME=     # your Africa's Talking app username ("sandbox" = their simulator, no real texts)
AFRICASTALKING_API_KEY=      # Africa's Talking dashboard → Settings → API Key
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# ---- Email (mock = log only) ----
# Render's FREE plan blocks SMTP, so on Render use brevo (or resend): they send over HTTPS.
EMAIL_PROVIDER=mock          # mock | brevo | resend | smtp
EMAIL_FROM=                  # the sender address you verified with the provider
EMAIL_FROM_NAME=Cadence
BREVO_API_KEY=               # brevo.com → SMTP & API → API keys (free: 300 emails/day)
RESEND_API_KEY=              # resend.com → API Keys (needs your own domain to email other people)
# smtp only (local testing or a paid Render plan):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=               # Gmail: an App Password, not your normal password

# ---- AI wording (numbers always come from Cadence's own analytics) ----
AI_PROVIDER=mock             # mock | anthropic | openai
AI_MODEL=                    # e.g. claude-haiku-5-5 (fast, low cost) or claude-sonnet-5-5; see docs.claude.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Daily digest trigger (cron-job.org calls POST /api/v1/alerts/cron with header X-Cron-Secret) ----
CRON_SECRET=

# ---- Password reset links and website demo requests ----
APP_URL=http://localhost:5173  # your Vercel address in production, no trailing slash
RESET_LINK_MINUTES=60
DEMO_NOTIFY_EMAIL=             # your inbox: "Book a demo" requests and new pharmacy sign-ups are emailed here
SIGNUP_ENABLED=true            # false = only you can add pharmacies (python -m app.create_admin)
HQ_NOTIFY_EMAIL=               # where "Get help" requests go (defaults to DEMO_NOTIFY_EMAIL)
HQ_NOTIFY_SMS=                 # your phone, texted for URGENT help requests (defaults to DEMO_NOTIFY_SMS)
HQ_DIGEST_ENABLED=true         # daily HQ email to HQ_NOTIFY_EMAIL: AI briefing, sign-ups, who's gone quiet, open help requests
HQ_DIGEST_TIME=08:00           # sent by the cron after this time, UTC (= Ghana time)
DEMO_NOTIFY_SMS=               # optional: also text this number, e.g. +233 24 000 0000

# ---- Encryption of personal data at rest (phone numbers, PSGH reg. no., alert recipients, demo leads) ----
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use the SAME value locally and on Render. Losing it means losing access to that data.
DATA_ENCRYPTION_KEY=
